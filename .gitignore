# ROMs (no se distribuyen)
roms/*
!roms/.gitkeep

# Copia de la ROM dentro de la integracion custom de stable-retro
# (data.json/scenario.json/metadata.json/rom.sha si se trackean, la ROM no)
src/custom_integrations/*/rom.sfc
src/custom_integrations/*/rom.smc
src/custom_integrations/*/*.state

# Modelos entrenados
models/*.zip

# Logs de entrenamiento (TensorBoard, etc.)
logs/*

# Videos generados
videos/*.mp4

# Python
__pycache__/
*.pyc
venv/
.venv/
